From fc044ca22308e23e43f50e6b101c1fdedb35ad6b Mon Sep 17 00:00:00 2001
From: Contributor <me@Contributorr.co>
Date: Tue, 21 Jul 2026 19:21:44 -0500
Subject: [PATCH] clk: qcom: dispcc-sdm845: add MDSS core reset

Expose the MDSS core BCR so the mdss driver's optional reset fully resets
the display block at probe, clearing the bootloader's live display state
(continuous splash). Without it the DPU inherits half-configured ABL state
on the AYN Odin: a flickering tear band duplicating other screen content,
identical in command and video panel modes. From the pmOS ayn-odin kernel
(gitlab.com/jenneron/linux 6075dab0), where the reset map entry was added
for exactly this (dts hookup left experimental there; we enable it).
---
 drivers/clk/qcom/dispcc-sdm845.c               | 1 +
 include/dt-bindings/clock/qcom,dispcc-sdm845.h | 1 +
 2 files changed, 2 insertions(+)

diff --git a/drivers/clk/qcom/dispcc-sdm845.c b/drivers/clk/qcom/dispcc-sdm845.c
index 78e43f6..fbf1c2e 100644
--- a/drivers/clk/qcom/dispcc-sdm845.c
+++ b/drivers/clk/qcom/dispcc-sdm845.c
@@ -816,6 +816,7 @@ static struct clk_regmap *disp_cc_sdm845_clocks[] = {
 
 static const struct qcom_reset_map disp_cc_sdm845_resets[] = {
 	[DISP_CC_MDSS_RSCC_BCR] = { 0x5000 },
+	[DISP_CC_MDSS_CORE_BCR] = { 0x2000 },
 };
 
 static struct gdsc *disp_cc_sdm845_gdscs[] = {
diff --git a/include/dt-bindings/clock/qcom,dispcc-sdm845.h b/include/dt-bindings/clock/qcom,dispcc-sdm845.h
index 4016fd1..f3e088b 100644
--- a/include/dt-bindings/clock/qcom,dispcc-sdm845.h
+++ b/include/dt-bindings/clock/qcom,dispcc-sdm845.h
@@ -49,6 +49,7 @@
 
 /* DISP_CC Reset */
 #define DISP_CC_MDSS_RSCC_BCR					0
+#define DISP_CC_MDSS_CORE_BCR					1
 
 /* DISP_CC GDSCR */
 #define MDSS_GDSC						0
