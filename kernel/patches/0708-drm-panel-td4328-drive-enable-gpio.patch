drm/panel: td4328: drive the panel enable GPIO (tlmm 120)

The TD4328 is a TDDI controller: the touch block shares silicon with the
display driver IC. jenneron's odin-7.1 tree (hardware-validated with the
rmi4 panel-follower touch driver we carry as 0034) drives an enable GPIO
(tlmm 120) high 20ms before releasing panel reset; without it the display
happens to work but the touch block never powers, and rmi4 probe NAKs
(rmi_set_page: -6). Port exactly the enable-GPIO sequencing; keep our
validated init blob and DSI link-rate timing hack unchanged.

Pairs with the DT change adding enable-gpios to the panel node.

--- a/drivers/gpu/drm/panel/panel-innolux-td4328.c	2026-07-25 14:00:07
+++ b/drivers/gpu/drm/panel/panel-innolux-td4328.c	2026-07-25 14:00:07
@@ -16,6 +16,7 @@
 	struct mipi_dsi_device *dsi;
 	struct regulator_bulk_data supplies[3];
 	struct gpio_desc *reset_gpio;
+	struct gpio_desc *enable_gpio;
 	enum drm_panel_orientation orientation;
 	bool prepared;
 };
@@ -92,12 +93,17 @@
 		return ret;
 	}
 
+	msleep(20);
+	gpiod_set_value_cansleep(ctx->enable_gpio, 1);
+	msleep(20);
+
 	innolux_td4328_reset(ctx);
 
 	ret = innolux_td4328_on(ctx);
 	if (ret < 0) {
 		dev_err(dev, "Failed to initialize panel: %d\n", ret);
 		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		gpiod_set_value_cansleep(ctx->enable_gpio, 0);
 		regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
 		return ret;
 	}
@@ -120,6 +126,7 @@
 		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
 
 	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	gpiod_set_value_cansleep(ctx->enable_gpio, 0);
 	regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
 
 	ctx->prepared = false;
@@ -206,6 +213,11 @@
 		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
 				     "Failed to get reset-gpios\n");
 
+	ctx->enable_gpio = devm_gpiod_get(dev, "enable", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->enable_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->enable_gpio),
+				     "Failed to get enable-gpios\n");
+
 	ret = of_drm_get_panel_orientation(dev->of_node, &ctx->orientation);
 	if (ret < 0) {
 		dev_err(dev, "Failed to get orientation %d\n", ret);
