From: Armada OS <armada@localhost>
Subject: [PATCH] Input: rmi4 - support following a DRM panel (from pmOS odin)

The AYN Odin's Synaptics RMI4 touch controller shares power/reset
sequencing with the display panel: probing or resuming it while the
panel is unpowered NAKs on I2C ("rmi_set_page: set page failed: -6").
Register as a DRM panel follower when the DT node carries a panel
property, suspending/resuming the controller with panel unprepare/
prepare, and let the follower own PM instead of the standard dev_pm
ops. Ported from gitlab.com/jenneron/linux odin-7.1 (used by the pmOS
port); pairs with panel = <&display_panel> in sdm845-ayn-odin.dts.

--- a/drivers/input/rmi4/rmi_i2c.c
+++ b/drivers/input/rmi4/rmi_i2c.c
@@ -10,6 +10,7 @@
 #include <linux/of.h>
 #include <linux/delay.h>
 #include <linux/regulator/consumer.h>
+#include <drm/drm_panel.h>
 #include "rmi_driver.h"
 
 #define BUFFER_SIZE_INCREMENT 32
@@ -43,6 +44,10 @@
 	struct regulator_bulk_data supplies[2];
 	struct gpio_desc *reset_gpio;
 	u32 startup_delay;
+
+	struct drm_panel_follower panel_follower;
+	bool follows_panel;
+	bool suspended_by_panel;
 	u32 reset_delay;
 };
 
@@ -200,8 +205,45 @@
 	struct rmi_i2c_xport *rmi_i2c = data;
 
 	rmi_unregister_transport_device(&rmi_i2c->xport);
+}
+
+static int rmi_i2c_panel_prepared(struct drm_panel_follower *follower)
+{
+	struct rmi_i2c_xport *rmi_i2c =
+		container_of(follower, struct rmi_i2c_xport, panel_follower);
+	int error;
+
+	if (!rmi_i2c->suspended_by_panel)
+		return 0;
+
+	msleep(rmi_i2c->startup_delay);
+
+	error = rmi_driver_resume(rmi_i2c->xport.rmi_dev, false);
+	rmi_i2c->suspended_by_panel = false;
+
+	return error;
+}
+
+static int rmi_i2c_panel_unpreparing(struct drm_panel_follower *follower)
+{
+	struct rmi_i2c_xport *rmi_i2c =
+		container_of(follower, struct rmi_i2c_xport, panel_follower);
+	int error;
+
+	if (rmi_i2c->suspended_by_panel)
+		return 0;
+
+	error = rmi_driver_suspend(rmi_i2c->xport.rmi_dev, false);
+	rmi_i2c->suspended_by_panel = true;
+
+	return error;
 }
 
+static const struct drm_panel_follower_funcs rmi_i2c_panel_follower_funcs = {
+	.panel_prepared = rmi_i2c_panel_prepared,
+	.panel_unpreparing = rmi_i2c_panel_unpreparing,
+};
+
 static int rmi_i2c_probe(struct i2c_client *client)
 {
 	struct rmi_device_platform_data *pdata;
@@ -306,6 +348,18 @@
 	if (error)
 		return error;
 
+	if (drm_is_panel_follower(&client->dev)) {
+		rmi_i2c->panel_follower.funcs = &rmi_i2c_panel_follower_funcs;
+
+		error = devm_drm_panel_add_follower(&client->dev,
+						    &rmi_i2c->panel_follower);
+		if (error)
+			return dev_err_probe(&client->dev, error,
+					     "failed to follow panel\n");
+
+		rmi_i2c->follows_panel = true;
+	}
+
 	return 0;
 }
 
@@ -315,6 +369,9 @@
 	struct rmi_i2c_xport *rmi_i2c = i2c_get_clientdata(client);
 	int ret;
 
+	if (rmi_i2c->follows_panel)
+		return 0;
+
 	ret = rmi_driver_suspend(rmi_i2c->xport.rmi_dev, true);
 	if (ret)
 		dev_warn(dev, "Failed to resume device: %d\n", ret);
@@ -331,6 +388,9 @@
 	struct rmi_i2c_xport *rmi_i2c = i2c_get_clientdata(client);
 	int ret;
 
+	if (rmi_i2c->follows_panel)
+		return 0;
+
 	ret = regulator_bulk_enable(ARRAY_SIZE(rmi_i2c->supplies),
 				    rmi_i2c->supplies);
 	if (ret)
@@ -351,6 +411,9 @@
 	struct rmi_i2c_xport *rmi_i2c = i2c_get_clientdata(client);
 	int ret;
 
+	if (rmi_i2c->follows_panel)
+		return 0;
+
 	ret = rmi_driver_suspend(rmi_i2c->xport.rmi_dev, false);
 	if (ret)
 		dev_warn(dev, "Failed to resume device: %d\n", ret);
@@ -367,6 +430,9 @@
 	struct rmi_i2c_xport *rmi_i2c = i2c_get_clientdata(client);
 	int ret;
 
+	if (rmi_i2c->follows_panel)
+		return 0;
+
 	ret = regulator_bulk_enable(ARRAY_SIZE(rmi_i2c->supplies),
 				    rmi_i2c->supplies);
