# Pinned by digest, not the :44 tag, so the build toolchain can't drift.
BUILDER_IMAGE=registry.fedoraproject.org/fedora@sha256:a9ccf0cff3052c49773c03f5c9deb6f4ac898b371cd4bb3c361670627402dfad

# Baseline CPU flags for packages that opt into Armada-specific tuning. Keep
# this to features shared by Armada's current Snapdragon targets: SM8550 lacks
# bf16, and SM8750/Oryon does not expose SVE.
#
# Overridable from the environment for older-SoC package variants. SDM845
# (AYN Odin: Cortex-A75/A55) has no dotprod or i8mm — build fex/mesa/
# mangohud/gamescope for it with:
#   ARMADA_MARCH="-march=armv8.2-a+fp16 -mtune=cortex-a75" ./build.sh
ARMADA_MARCH="${ARMADA_MARCH:-"-march=armv8.2-a+fp16+dotprod+i8mm -mtune=cortex-a78"}"

# Extra `podman run` args for the emulated (non-aarch64 host) package builds.
# Under qemu-user, podman's default seccomp profile returns ENOSYS for syscalls
# qemu issues (e.g. tar during rpm %prep: "Cannot open: Function not
# implemented"), so disable seccomp for the build container. Native aarch64
# builds (incl. CI) keep the default profile. Force-enable with
# ARMADA_BUILD_UNCONFINED=1 regardless of host arch.
if [[ "$(uname -m)" == "aarch64" && -z "${ARMADA_BUILD_UNCONFINED:-}" ]]; then
    ARMADA_PODMAN_SECOPTS=()
else
    ARMADA_PODMAN_SECOPTS=(--security-opt seccomp=unconfined)
fi
